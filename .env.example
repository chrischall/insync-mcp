# insync-mcp reads one InSync Healthcare (Qualifacts) patient portal
# (https://<practice>intouch.insynchcs.com). It is NOT read-only: besides reads
# it downloads portal files and uploads an insurance card (confirm-gated), and
# opening an unread message can mark it read.

# The portal — scheme + host only, no path. Required.
# INSYNC_PORTAL=https://<practice>intouch.insynchcs.com

# Server-side password login (the default transport when both are set). The
# portal counts failed sign-ins toward an account lockout, so a rejected login
# is never retried automatically.
# INSYNC_USERNAME=
# INSYNC_PASSWORD=

# server | fetchproxy. Default: server when both credentials are set, otherwise
# fetchproxy (relays through your signed-in portal tab; holds no credentials).
# INSYNC_TRANSPORT=

# fetchproxy concentrator port. The whole fetchproxy fleet shares 37149 — the
# ContextMint Bridge extension dials that one port. Override only when hosting.
# INSYNC_WS_PORT=37149

# Where downloaded files are written (a path-delimiter list; ~ expands).
# Default ~/Downloads and ~/Documents. A per-call dest must resolve inside one.
# INSYNC_OUTPUT_DIR=

# true returns downloaded bytes inline (base64) instead of writing to disk —
# for a hosted runner whose disk you cannot reach. Default false (disk).
# INSYNC_INLINE_DOWNLOADS=

# Confirm-gate behaviour for the insurance-card upload (from @chrischall/mcp-utils).
# MCP_CONFIRM_MODE: ask-user (default) returns a preview + confirmToken and
# requires a second call with that token; auto lets a capable host confirm in one
# step; an unrecognised value fails closed (refuse). MCP_CONFIRM_ELICITATION: on
# (default) lets the host confirm interactively; off forces the token round-trip.
# MCP_CONFIRM_MODE=
# MCP_CONFIRM_ELICITATION=

# insync-mcp is READ-ONLY. It reads one InSync Healthcare (Qualifacts) patient
# portal: https://<practice>intouch.insynchcs.com.

# The portal to read — scheme + host only, no path. Required.
# INSYNC_PORTAL=https://<practice>intouch.insynchcs.com

# Server-side password login (the default transport when both are set). The
# portal counts failed sign-ins toward an account lockout, so a rejected login
# is never retried automatically.
# INSYNC_USERNAME=
# INSYNC_PASSWORD=

# server | fetchproxy. Default: server when both credentials are set, otherwise
# fetchproxy (relays through your signed-in portal tab; holds no credentials).
# INSYNC_TRANSPORT=

# fetchproxy concentrator port. The whole fetchproxy fleet shares 37149 — the
# ContextMint Bridge extension dials that one port. Override only when hosting.
# INSYNC_WS_PORT=37149
